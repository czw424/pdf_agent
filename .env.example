# 复制此文件为 .env，然后修改配置
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2:7b-instruct

# Embedding（走Ollama，需要先 ollama pull bge-m3）
EMBED_MODEL_NAME=bge-m3
EMBED_DEVICE=cpu

# HuggingFace镜像：Reranker首次运行会下载CrossEncoder权重
# 国内直连 huggingface.co 基本下不动，默认走 hf-mirror.com；网络通畅可留空
HF_ENDPOINT=https://hf-mirror.com

# Reranker（本地下载CrossEncoder模型，首次运行会联网拉取；失败会自动降级为「混合检索+阈值」）
USE_RERANKER=true
RERANK_MODEL_PATH=BAAI/bge-reranker-base
RERANK_TOP_N=3
# CrossEncoder打分阈值，logit低于该值视为不相关，不交给LLM
RERANK_SCORE_THRESHOLD=0.0
RETRIEVE_INIT_K=8

# 混合检索：BM25(关键词) + 向量检索，RRF融合
USE_HYBRID_SEARCH=true
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
RRF_K=60

QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=rag_demo

UPLOAD_DIR=./uploads

# temperature=0：事实型问答不需要模型发挥
TEMPERATURE=0.0
# 中文1个汉字≈1个token，上下文窗口要留足，否则Ollama会截断prompt
N_CTX=8192
MAX_TOKENS=2048

# RETRIEVER_K：最终交给LLM的分片数量
RETRIEVER_K=3
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# 向量检索相似度阈值
SIMILARITY_THRESHOLD=0.45
# 单次拼给LLM的上下文字符上限
MAX_CONTEXT_CHARS=3000

# 检索不到相关内容时的固定回复
NO_ANSWER_TEXT=文档未找到相关信息

# 多轮对话最多保留的轮数
SESSION_HISTORY_MAX_TURNS=5
